# ─── Better Auth ───────────────────────────────────────────────────────────────
# Encryption secret (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here
# Base URL of the app (no trailing slash). Set to the prod domain in production.
# Also the issuer AND audience of the JWTs sent to the backend: the backend's
# AUTH_ISSUER must equal this exactly, and AUTH_JWKS_URL is {this}/api/auth/jwks.
# Local dev: use http://127.0.0.1:3000 (not localhost).
BETTER_AUTH_URL=http://127.0.0.1:3000

# Postgres connection. Better Auth tables live in the `resume_match` schema.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Google OAuth (optional) ─────────────────────────────────────────────────────
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
# The "Continue with Google" button only activates when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Resend (email OTP: verification + password reset) ─────────────────────────
# Server-only, runtime. Never NEXT_PUBLIC_*.
RESEND_API_KEY=re_your_key
# UNQUOTED, deliberately: dotenv strips quotes locally but Coolify/Docker pass
# the raw string through, and Resend 422s on a `from` containing quote chars.
# The domain must exactly match a verified domain in Resend, and the address
# must stay in sync with OTP_SENDER_EMAIL in src/lib/otp-sender.ts.
RESEND_FROM_EMAIL=ResuMatchAI <noreply@verification.your-domain.com>

# ─── FastAPI backend (backend/) ────────────────────────────────────────────────
# Public URL the BROWSER calls with a Better Auth JWT. Build-time (NEXT_PUBLIC_*),
# no trailing slash. Local dev: the backend must list http://127.0.0.1:3000 in its
# CORS_ORIGINS. Production: https://api.resumatch.zeeshanai.cloud
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Server-only, runtime. How THIS Next.js server reaches the backend (account
# deletion calls DELETE /internal/users/{id}). In Coolify use the internal
# Docker hostname if the backend is on the same network.
API_INTERNAL_URL=http://127.0.0.1:8000
# Shared secret for that call. Must equal the backend's INTERNAL_API_KEY.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY=your_internal_api_key

# ─── Contact form (n8n webhook, the only remaining n8n use) ────────────────────
# The contact form still posts to an n8n workflow (URL is in src/app/api/contact).
N8N_API_KEY=your_n8n_header_auth_value

# ─── Umami Analytics ─────────────────────────────────────────────────────────────
# Must be present at BUILD time (NEXT_PUBLIC_*).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Upstash Redis (contact-form rate limiting) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
