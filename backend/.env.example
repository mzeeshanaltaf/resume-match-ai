# ResuMatchAI backend configuration. Copy to backend/.env (gitignored) and adjust.
# Every value below is optional unless marked REQUIRED; defaults are shown.
# The backend reads backend/.env and the process environment only. It deliberately does
# NOT read the repo-root .env.local (that file holds the production DATABASE_URL).

# ── General ──────────────────────────────────────────────────────────────────
ENVIRONMENT=dev                  # dev | test | prod (prod hides /docs and /openapi.json)
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev Postgres: docker compose -f docker-compose.dev.yml up -d
# Production (Coolify): host 10.0.0.1, same server as the Better Auth database.
# REQUIRED in production.
DATABASE_URL=postgresql://resumatch:resumatch@127.0.0.1:5433/resumatch_dev
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── OpenAI (Responses API + Decisions API) ───────────────────────────────────
OPENAI_API_KEY=                  # REQUIRED from phase 2
LLM_MODEL=gpt-6-luna
LLM_SERVICE_TIER=flex
LLM_FALLBACK_SERVICE_TIER=default   # empty = no fallback retry
LLM_REASONING_EFFORT=low            # minimal | low | medium | high
# Per-task overrides (empty = use LLM_REASONING_EFFORT):
LLM_MATCH_REASONING_EFFORT=
LLM_JD_REASONING_EFFORT=
LLM_OCR_REASONING_EFFORT=
LLM_BULLETS_REASONING_EFFORT=
LLM_COVER_LETTER_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=600
DECISION_MODEL=gpt-6-luna
DECISION_MIN_PROBABILITY=0.7

# ── Firecrawl (job-page scraping) ────────────────────────────────────────────
FIRECRAWL_API_KEY=               # REQUIRED from phase 2
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT_SECONDS=120
FIRECRAWL_POLL_INTERVAL_SECONDS=2

# ── Upload and input limits ──────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880         # 5 MB
MAX_RESUME_PAGES=5
MAX_RESUME_CHARS=20000
MAX_JD_CHARS=20000
MAX_SCREENING_RESUMES=20
MAX_RESUMES_PER_USER=50
SCANNED_PDF_MIN_CHARS=20         # text layer shorter than this => vision OCR

# ── Credits ──────────────────────────────────────────────────────────────────
SIGNUP_CREDITS=10
MATCH_CREDIT_COST=1
COVER_LETTER_CREDIT_COST=1
SCREENING_CREDIT_COST_PER_RESUME=1
# Salt for the hash of deleted-account emails. REQUIRED in production: generate once
# (openssl rand -hex 32) and never change it (changing it forgets prior deletions).
EMAIL_HASH_SALT=dev-only-change-me

# ── Account export ───────────────────────────────────────────────────────────
EXPORT_COOLDOWN_SECONDS=3600

# ── Object storage ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local            # local (dev/tests) | s3 (MinIO in production)
STORAGE_LOCAL_DIR=.local_storage
S3_ENDPOINT=                     # e.g. http://minio:9000 (internal Docker hostname)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true         # required by MinIO
STORAGE_SWEEP_ON_STARTUP=true
STORAGE_SWEEP_MIN_AGE_SECONDS=3600

# ── Auth (Better Auth JWT, EdDSA) ────────────────────────────────────────────
# Local dev: point both at the Next.js dev server, e.g. http://127.0.0.1:3000
AUTH_JWKS_URL=https://resumatch.zeeshanai.cloud/api/auth/jwks
AUTH_ISSUER=https://resumatch.zeeshanai.cloud
AUTH_AUDIENCE=                   # empty = same as AUTH_ISSUER (Better Auth default)
AUTH_ALGORITHMS=EdDSA
AUTH_JWKS_CACHE_SECONDS=3600
AUTH_JWKS_MIN_REFRESH_SECONDS=30
AUTH_LEEWAY_SECONDS=10

# ── HTTP ─────────────────────────────────────────────────────────────────────
# Comma-separated frontend origin(s). Local dev: http://127.0.0.1:3000
CORS_ORIGINS=https://resumatch.zeeshanai.cloud
# Shared secret for Better Auth -> /internal/* calls. Empty disables the internal API.
INTERNAL_API_KEY=

# ── Tests only (not read by the app) ─────────────────────────────────────────
# TEST_DATABASE_URL=postgresql://resumatch:resumatch@127.0.0.1:5433/resumatch_test
# REQUIRE_DB_TESTS=1             # fail instead of skip when Postgres is unreachable
# TEST_S3_ENDPOINT= / TEST_S3_ACCESS_KEY= / TEST_S3_SECRET_KEY= / TEST_S3_BUCKET=
