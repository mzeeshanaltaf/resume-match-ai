# ─── Better Auth ───────────────────────────────────────────────────────────────
# Encryption secret (min 32 chars). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=your_generated_secret_here
# Base URL of the app (no trailing slash). Set to the prod domain in production.
BETTER_AUTH_URL=http://localhost:3000

# Postgres connection. Better Auth tables live in the `resume_match` schema.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Google OAuth (optional) ─────────────────────────────────────────────────────
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
# The "Continue with Google" button only activates when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Resend (email OTP: verification + password reset) ─────────────────────────
# Server-only, runtime. Never NEXT_PUBLIC_*.
RESEND_API_KEY=re_your_key
# UNQUOTED, deliberately: dotenv strips quotes locally but Coolify/Docker pass
# the raw string through, and Resend 422s on a `from` containing quote chars.
# The domain must exactly match a verified domain in Resend, and the address
# must stay in sync with OTP_SENDER_EMAIL in src/lib/otp-sender.ts.
RESEND_FROM_EMAIL=ResuMatchAI <noreply@verification.your-domain.com>

# ─── n8n Workflow Backend ──────────────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook
N8N_API_KEY=your_n8n_header_auth_value
N8N_MAIN_WEBHOOK_ID=
N8N_ANALYTICS_WEBHOOK_ID=
N8N_CREDITS_WEBHOOK_ID=
N8N_DATA_WEBHOOK_ID=
N8N_DELETE_WEBHOOK_ID=

# ─── Umami Analytics ─────────────────────────────────────────────────────────────
# Must be present at BUILD time (NEXT_PUBLIC_*).
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami-instance.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Upstash Redis (contact-form rate limiting) ─────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
